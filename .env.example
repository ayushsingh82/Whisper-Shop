# Bitrefill eCommerce MCP key (bitrefill.com/account/developers). Never commit the real value.
BITREFILL_API_KEY=

# Live Zcash wallet (zcash-devtool). Leave unset to use the simulated wallet.
# Keep wallet directories and identity files OUTSIDE this repository.
WHISPER_WALLET_DIR=
WHISPER_IDENTITY=
ZCASH_DEVTOOL_BIN=zcash-devtool
ZCASH_SERVER=zecrocks
