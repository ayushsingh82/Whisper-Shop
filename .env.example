# Whisper Shop: main settings only. Copy to .env.local (never commit the real values).

# --- Bitrefill (the shop). Create at bitrefill.com/account/developers ---
BITREFILL_API_KEY=

# --- Live Zcash wallet (needs the zcash-devtool binary, so NOT available on Vercel) ---
# Keep wallet directories and identity files OUTSIDE this repository.
WHISPER_WALLET_DIR=
WHISPER_IDENTITY=

# --- Optional (defaults shown) ---
# ZCASH_SERVER=zecrocks            # lightwalletd alias or URL
# ZCASH_DEVTOOL_BIN=zcash-devtool
# WHISPER_HOME=~/.whisper-shop     # where the helper scripts look for the buyer/shop wallets
# MAX_ORDER_USD=20                 # per-order spending cap
# DAILY_CAP_USD=50                 # daily spending cap
# ZEC_USD=400                      # price used to value a payment in cap checks
# ORDERS_FILE=.data/orders.json    # order store (defaults to /tmp on Vercel)
# NEXT_PUBLIC_EXPLORER_URL=https://testnet.zcashexplorer.app/transactions
